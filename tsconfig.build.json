{
  // Emits the publishable package: JavaScript + type declarations in `dist/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": ["core", "logger", "reporting", "settings"]
}
